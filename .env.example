# ==============================================================================
# UNERA Environment Configuration Template
# Sao chép file này thành .env.local để sử dụng trong môi trường phát triển cục bộ
# ==============================================================================

# Cấu hình Môi trường
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:8000

# Cơ sở dữ liệu MongoDB (Local hoặc MongoDB Atlas)
# Ví dụ local: mongodb://localhost:27017/unera
# Ví dụ Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/unera?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/unera

# Xác thực JWT Dual-Token (Access Token 15m + Refresh Token 7d/30d)
# Tạo secret ngẫu nhiên bằng lệnh: openssl rand -base64 32
JWT_ACCESS_SECRET=your-random-access-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-random-refresh-secret-key-at-least-32-characters

# Google OAuth 2.0 (Đăng nhập & Tự động đăng ký bằng Gmail)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Dịch vụ gửi Email thông báo (SMTP / Resend / SendGrid)
EMAIL_FROM="UNERA <no-reply@unera.edu.vn>"
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD=your-smtp-password

# Cấu hình Lưu trữ tệp tin (File Upload - Giới hạn tối đa 10MB theo SRS)
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
FILE_STORAGE_PROVIDER=local # local | s3 | cloudinary
UPLOAD_DIR=./public/uploads

# Cron Secret cho Job Nhắc nhở tự động (/api/cron/reminders)
CRON_SECRET=replace-with-a-long-random-cron-secret

# Google Gemini AI API (Server-only - Module 08 Định hướng & Lộ trình AI)
# Tạo API Key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

