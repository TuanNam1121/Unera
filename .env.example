# ==============================================================================
# UNERA Environment Configuration Template
# Sao chép file này thành .env.local để sử dụng trong môi trường phát triển cục bộ
# ==============================================================================

# Cấu hình Môi trường
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cơ sở dữ liệu MongoDB (Local hoặc MongoDB Atlas)
# Ví dụ local: mongodb://localhost:27017/unera
# Ví dụ Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/unera?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/unera

# Xác thực NextAuth / Auth.js
# Tạo secret ngẫu nhiên bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Dành cho đăng nhập bằng tài khoản Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Dịch vụ gửi Email thông báo (SMTP / Resend / SendGrid)
EMAIL_FROM="UNERA <no-reply@unera.edu.vn>"
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD=your-smtp-password

# Cấu hình Lưu trữ tệp tin (File Upload - Giới hạn tối đa 10MB theo SRS)
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
FILE_STORAGE_PROVIDER=local # local | s3 | cloudinary
UPLOAD_DIR=./public/uploads

